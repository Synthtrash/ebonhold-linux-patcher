{
  "branches": ["main"],
  "plugins": [
    "@semantic-release/commit-analyzer",
    "@semantic-release/release-notes-generator",
    {
      "path": "@semantic-release/github",
      "assets": [
        {
          "path": "dist/ebonhold-launcher-linux-amd64.tar.gz",
          "name": "ebonhold-launcher-linux-amd64.tar.gz",
          "label": "Ebonhold Launcher (Linux x86_64, X11/XWayland)"
        },
        {
          "path": "dist/ebonhold-launcher-linux-amd64.tar.gz.sha256",
          "name": "ebonhold-launcher-linux-amd64.tar.gz.sha256",
          "label": "SHA-256 checksum (X11/XWayland)"
        },
        {
          "path": "dist/ebonhold-launcher-linux-amd64-wayland.tar.gz",
          "name": "ebonhold-launcher-linux-amd64-wayland.tar.gz",
          "label": "Ebonhold Launcher (Linux x86_64, native Wayland)"
        },
        {
          "path": "dist/ebonhold-launcher-linux-amd64-wayland.tar.gz.sha256",
          "name": "ebonhold-launcher-linux-amd64-wayland.tar.gz.sha256",
          "label": "SHA-256 checksum (native Wayland)"
        }
      ]
    }
  ]
}
